# Copy this file to .env (same folder) and fill in your values.
# rtkrcv replaces ${NAME} in the stream paths of an options file with the value
# of NAME from the environment or, if it is not set there, from the nearest
# .env file: in the folder of that options file or a folder above it, up to the
# top of the repository. Git ignores .env.
#
# One NAME=VALUE per line. The value is the rest of the line; quotes around it
# are optional and '#' inside it is kept.

NTRIP_USER=your-caster-user
NTRIP_PASSWORD=your-caster-password
NTRIP_HOST=caster.example.com
NTRIP_PORT=2101
NTRIP_MOUNTPOINT=MOUNTPOINT
